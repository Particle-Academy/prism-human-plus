{
    "name": "particle-academy/prism-human-plus",
    "description": "Human+ participant presence for Prism Harness — join live Fancy surfaces through trusted MCP relay attachments.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "laravel/framework": "^12.61.1|^13.12.0",
        "particle-academy/prism": ">=0.114 <1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "particle-academy/prism-harness": "Binds Human+ participant attachments to durable Harness sessions."
    },
    "autoload": {"psr-4": {"Prism\\HumanPlus\\": "src/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {"test": "@php vendor/bin/pest", "types": "@php vendor/bin/phpstan analyse", "format": "@php vendor/bin/pint"},
    "extra": {"laravel": {"providers": ["Prism\\HumanPlus\\PrismHumanPlusServiceProvider"]}},
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {"sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true}}
}
